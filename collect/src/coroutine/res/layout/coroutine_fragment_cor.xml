<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="10dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kotlin协程"
                android:textColor="#FF0F172A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="协程就是Kotlin的封装类，封装方法暂停再原地继续执行的机制，他可以跑在任何线程上，利用系统的暂停机制，非常高效，跟线程暂停/切换相比，cpu资源消耗非常低。"
                android:textColor="#FF475569"
                android:textSize="14sp" />

            <TextView
                style="@style/CorThreadSectionTitle"
                android:text="一、体验协程" />

            <LinearLayout style="@style/CorThreadBtnRow">

                <Button
                    android:id="@+id/cor_btn_launch"
                    style="@style/CorThreadBtn"
                    android:text="启动协程：launch" />

                <Button
                    android:id="@+id/cor_btn_kill_callback"
                    style="@style/CorThreadBtn"
                    android:text="网络请求 干掉callback" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="经典：子线程请求网络，主线程刷新UI" />

            <TextView
                style="@style/CorThreadSectionTitle"
                android:text="二、Dispather" />

            <LinearLayout style="@style/CorThreadBtnRow">

                <Button
                    android:id="@+id/cor_btn_switch_thread"
                    style="@style/CorThreadBtn"
                    android:text="切线程 withContxt(IO)" />

                <Button
                    android:id="@+id/cor_btn_ui_on_io"
                    style="@style/CorThreadBtn"
                    android:text="误区：IO线程碰UI" />

            </LinearLayout>

            <TextView
                style="@style/CorThreadSectionTitle"
                android:text="三、协程控制" />

            <LinearLayout style="@style/CorThreadBtnRow">

                <Button
                    android:id="@+id/cor_btn_sync"
                    style="@style/CorThreadBtn"
                    android:text="串行请求: 两个挂起函数顺序执行" />

                <Button
                    android:id="@+id/cor_btn_async"
                    style="@style/CorThreadBtn"
                    android:text="并行请求: async/await" />

            </LinearLayout>

            <LinearLayout style="@style/CorThreadBtnRow">

                <Button
                    android:id="@+id/cor_btn_join"
                    style="@style/CorThreadBtn"
                    android:text="分叉和汇合: \njoin" />

                <Button
                    android:id="@+id/cor_btn_cancel_start"
                    style="@style/CorThreadBtn"
                    android:text="协作式取消：\n启动任务" />

            </LinearLayout>

            <LinearLayout style="@style/CorThreadBtnRow">

                <Button
                    android:id="@+id/cor_btn_cancel_do"
                    style="@style/CorThreadBtn"
                    android:text="取消任务：\ncancel" />

                <Button
                    android:id="@+id/cor_btn_with_timeout"
                    style="@style/CorThreadBtn"
                    android:text="超时控制：withTimeOut" />

            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="运行日志"
            android:textColor="#FF0F172A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="user info" />

        <Button
            android:id="@+id/cor_btn_clear_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/cor_sv_log"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="10dp"
        android:background="#FF111827"
        android:fillViewport="true">

        <TextView
            android:id="@+id/cor_tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="准备完成，点上面的按钮看日志。"
            android:textColor="#FFE2E8F0"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
